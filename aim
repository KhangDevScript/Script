local function UpdateESP(player)
	if not ESPObjects[player] then
		CreateESP(player)
	end

	local Data = ESPObjects[player]

	if not Data then
		return
	end

	local Character = player.Character

	if not Character then
		Data.Highlight.Enabled = false
		Data.Billboard.Enabled = false
		Data.Line.Visible = false
		return
	end

	local Root = Character:FindFirstChild("HumanoidRootPart") or Character:FindFirstChild("Head")
	local Humanoid = Character:FindFirstChildOfClass("Humanoid")

	if not Root then
		Data.Highlight.Enabled = false
		Data.Billboard.Enabled = false
		Data.Line.Visible = false
		return
	end

	if not Settings.ESP then
		Data.Highlight.Enabled = false
		Data.Billboard.Enabled = false
		Data.Line.Visible = false
		return
	end

	local Distance = (Camera.CFrame.Position - Root.Position).Magnitude

	if Distance > Settings.MaxDistance then
		Data.Highlight.Enabled = false
		Data.Billboard.Enabled = false
		Data.Line.Visible = false
		return
	end

	Data.Highlight.Adornee = Character
	Data.Highlight.Enabled = true

	if Settings.BoxESP then
		Data.Billboard.Adornee = Root
		Data.Billboard.Enabled = true
		Data.Box.Visible = true
		Data.Name.Text = player.Name
	else
		Data.Box.Visible = false
	end

	if Settings.HealthBar and Humanoid and Humanoid.MaxHealth > 0 then
		local healthPercent = math.clamp(Humanoid.Health / Humanoid.MaxHealth, 0, 1)
		Data.HealthBarFill.Size = UDim2.new(1, 0, healthPercent, 0)
		Data.HealthBarFill.Position = UDim2.new(0, 0, 1 - healthPercent, 0)
		Data.HealthBarFill.BackgroundColor3 = Color3.fromRGB(255 * (1 - healthPercent), 255 * healthPercent, 0)
		Data.HealthBarFill.Parent.Visible = true
	else
		Data.HealthBarFill.Parent.Visible = false
	end

	if Settings.LineESP then
		local vector, onScreen = Camera:WorldToViewportPoint(Root.Position)
		if onScreen then
			Data.Line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
			Data.Line.To = Vector2.new(vector.X, vector.Y)
			Data.Line.Visible = true
		else
			Data.Line.Visible = false
		end
	else
		Data.Line.Visible = false
	end
end

--==================================================
-- AIMBOT & SILENT AIM LOGIC (TỰ ĐỘNG LIA TÂM GẦN NHẤT)
--==================================================

local function GetAimPart(Character)
	if not Character then return nil end

	if Settings.AimPart == "Head" then
		return Character:FindFirstChild("Head") or Character:FindFirstChild("HumanoidRootPart")
	elseif Settings.AimPart == "Neck" then
		return Character:FindFirstChild("Head") or Character:FindFirstChild("UpperTorso")
	elseif Settings.AimPart == "Body" then
		return Character:FindFirstChild("UpperTorso")
			or Character:FindFirstChild("Torso")
			or Character:FindFirstChild("HumanoidRootPart")
	end

	return Character:FindFirstChild("Head")
end

local function GetClosestTarget()
	local Closest = nil
	local ClosestDistance = math.huge

	for _, Player in ipairs(Players:GetPlayers()) do
		if Player ~= LocalPlayer then
			local Character = Player.Character
			local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
			local Part = GetAimPart(Character)

			-- Kiểm tra người chơi còn sống và có phần cơ thể hợp lệ
			if Humanoid and Humanoid.Health > 0 and Part then
				local Distance3D = (Camera.CFrame.Position - Part.Position).Magnitude

				if Distance3D <= Settings.MaxDistance then
					-- Ưu tiên tìm mục tiêu có khoảng cách 3D thực tế gần người chơi nhất trên toàn map
					if Distance3D < ClosestDistance then
						ClosestDistance = Distance3D
						Closest = Part
					end
				end
			end
		end
	end

	return Closest
end

local function AimAt(Part)
	if not Part then return end
	local CameraPosition = Camera.CFrame.Position
	local Target = CFrame.lookAt(CameraPosition, Part.Position)
	-- Lia tâm thẳng dính ngay lập tức sang mục tiêu gần nhất
	Camera.CFrame = Camera.CFrame:Lerp(Target, Settings.Smoothness)
end

