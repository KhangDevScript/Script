VerifyBtn.MouseButton1Click:Connect(function()
    if KeyBox.Text == CORRECT_KEY then
        KeySystemFrame:Destroy()
        MainFrame.Visible = true
    else
        StatusLabel.Text = "Status: Invalid Key! Try again."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
    end
end)

local orbitAngle = 0
RunService.RenderStepped:Connect(function(deltaTime)
    if not _G.OrbitFly and not _G.Kaitun1ToMax then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart

    local targetPart = nil
    local minDist = math.huge
    local enemiesFolder = workspace:FindFirstChild("Enemies")
    
    if enemiesFolder then
        for _, enemy in ipairs(enemiesFolder:GetChildren()) do
            local eHrp = enemy:FindFirstChild("HumanoidRootPart")
            local eHum = enemy:FindFirstChild("Humanoid")
            if eHrp and eHum and eHum.Health > 0 then
                local dist = (hrp.Position - eHrp.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    targetPart = eHrp
                end
            end
        end
    end

    if targetPart then
        orbitAngle = orbitAngle + (4 * deltaTime)
        local offsetX = math.cos(orbitAngle) * 12
        local offsetZ = math.sin(orbitAngle) * 12
        local targetPos = targetPart.Position + Vector3.new(offsetX, 7, offsetZ)
        
        hrp.CFrame = CFrame.new(targetPos, targetPart.Position)
        hrp.Velocity = Vector3.new(0, 0, 0)
    end
end)

task.spawn(function()
    while task.wait(0.3) do
        if (_G.BringMobs or _G.Kaitun1ToMax) and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            pcall(function()
                local hrp = LocalPlayer.Character.HumanoidRootPart
                local enemiesFolder = workspace:FindFirstChild("Enemies")
                if enemiesFolder then
                    for _, enemy in ipairs(enemiesFolder:GetChildren()) do
                        local eHrp = enemy:FindFirstChild("HumanoidRootPart")
                        local eHum = enemy:FindFirstChild("Humanoid")
                        if eHrp and eHum and eHum.Health > 0 then
                            if (eHrp.Position - hrp.Position).Magnitude < 300 then
                                eHrp.CFrame = hrp.CFrame * CFrame.new(0, 0, -3)
                                eHrp.Velocity = Vector3.new(0, 0, 0)
                                if enemy:FindFirstChild("Head") then
                                    enemy.Head.CanCollide = false
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

local function requestAddStat(statName, amount)
    pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage
        local statRemote = remotes:FindFirstChild("CommF_")
        if statRemote then
            statRemote:InvokeServer("AddPoint", statName, amount)
        end
    end)
end

task.spawn(function()
    while task.wait(1) do
        if _G.AutoStats or _G.Kaitun1ToMax then
            pcall(function()
                local dataStats = LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Points")
                if dataStats and dataStats.Value > 0 then
                    for _, stat in ipairs(_G.StatsPriority) do
                        if dataStats.Value > 0 then
                            requestAddStat(stat, 1)
                        end
                    end
                end
            end)
        end
    end
end)

task.spawn(function()
    local bloxCodes = {
        "ADMIN_STRENGTH", "Sub2Fer999", "Enyu_is_Pro", "Magicbus", "JCWK", 
        "Starcodeheo", "Bluxxy", "fudd10_v2", "Fudd10", "BIGNEWS", 
        "TheGreatAce", "Sub2GAMERROBOT_EXP1", "Sub2NoobMaster123", "Sub2DaRock", 
        "Sub2UncleKizaru", "Sub2Oliveira", "Sub2Immutable", "Sub2OfficialNoobie", 
        "TantaiGaming", "StrawHatMaine", "Sub2Charming", "Axiore", "SubToDaInmortal"
    }

    while task.wait(5) do
        if _G.AutoCode or _G.Kaitun1ToMax then
            pcall(function()
                local dataFolder = LocalPlayer:FindFirstChild("Data")
                local hasActiveExp = false
                
                if dataFolder then
                    local expTime = dataFolder:FindFirstChild("ExpExpires") or dataFolder:FindFirstChild("DoubleExpTime")
                    if expTime and expTime.Value and expTime.Value > os.time() then
                        hasActiveExp = true
                    end
                end

                if not hasActiveExp then
                    local remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage
                    local codeRemote = remotes:FindFirstChild("CommF_")
                    if codeRemote then
                        for _, code in ipairs(bloxCodes) do
                            if not _G.AutoCode and not _G.Kaitun1ToMax then break end
                            codeRemote:InvokeServer("RedeemCode", code)
                            task.wait(2.5)
                        end
                    end
                end
            end)
        end
    end
end)

print("Khang Hub: Loaded successfully!")
