-- 2. Double Money Button
createButton("Double Money", function()
    local customName = InputBox.Text
    local money = find_money_value(customName)
    if money then
        local currentVal = money.Value
        if typeof(currentVal) == "number" then
            money.Value = currentVal * DOUBLE_MULTIPLIER
            print("[Khang_Dev] Money Doubled: " .. money.Value)
        else
            print("[Khang_Dev] Money value is not a number: " .. tostring(currentVal))
        end
    else
        print("[Khang_Dev] Money not found.")
    end
end)

