	Highlight.Parent = workspace

	local Billboard = Instance.new("BillboardGui")
	Billboard.Name = "KhangDzBox"
	Billboard.Size = UDim2.fromOffset(100, 130)
	Billboard.StudsOffset = Vector3.new(0, 2, 0)
	Billboard.AlwaysOnTop = true
	Billboard.Enabled = false
	Billboard.Parent = workspace

	local Box = Instance.new("Frame")
	Box.Size = UDim2.fromScale(1, 1)
	Box.BackgroundTransparency = 1
	Box.BorderSizePixel = 0
	Box.Parent = Billboard

	local BoxStroke = Instance.new("UIStroke")
	BoxStroke.Color = Color3.fromRGB(100, 255, 100)
	BoxStroke.Thickness = 2
	BoxStroke.Parent = Box

	local Name = Instance.new("TextLabel")
	Name.Size = UDim2.new(1, 0, 0, 20)
	Name.Position = UDim2.fromOffset(0, -23)
	Name.BackgroundTransparency = 1
	Name.TextColor3 = Color3.fromRGB(150, 255, 150)
	Name.TextStrokeTransparency = 0.3
	Name.TextSize = 12
	Name.Font = Enum.Font.GothamBold
	Name.Parent = Box

	ESPObjects[player] = {
		Highlight = Highlight,
		Billboard = Billboard,
		Name = Name
	}
end

local function UpdateESP(player)
	if not ESPObjects[player] then
		CreateESP(player)
	end

	local Data = ESPObjects[player]

	if not Data then
		return
	end

	local Character = player.Character

	if not Character then
		Data.Highlight.Enabled = false
		Data.Billboard.Enabled = false
		return
	end

	local Root = Character:FindFirstChild("HumanoidRootPart")
	local Humanoid = Character:FindFirstChildOfClass("Humanoid")

	if not Root or not Humanoid or Humanoid.Health <= 0 then
		Data.Highlight.Enabled = false
		Data.Billboard.Enabled = false
		return
	end

	if not Settings.ESP or not IsEnemy(player) then
		Data.Highlight.Enabled = false
		Data.Billboard.Enabled = false
		return
	end

	local Distance = (Camera.CFrame.Position - Root.Position).Magnitude

	if Distance > Settings.MaxDistance then
		Data.Highlight.Enabled = false
		Data.Billboard.Enabled = false
		return
	end

	Data.Highlight.Adornee = Character
	Data.Highlight.Enabled = true

	if Settings.BoxESP then
		Data.Billboard.Adornee = Root
		Data.Billboard.Enabled = true
		Data.Name.Text = player.Name
	else
		Data.Billboard.Enabled = false
	end
end

