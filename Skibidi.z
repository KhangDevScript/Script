-- Blox Fruits Ultra Script: Luck 999x + Time Skip + Free Fruit
-- Date: 2026-08-27
-- Author: NoTrack

local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local Mouse = Player:GetMouse()

-- ==========================================
-- 1. CONFIGURATION
-- ==========================================
local Settings = {
    TargetFruit = "Luck",       -- The specific fruit you want
    AutoSkipTime = true,        -- Skip time every cycle?
    FreeFruitOnly = true,       -- Only use the Free Fruit spawn (no Beli cost)
    MaxRolls = 999,             -- Stop after 999 rolls if not found
    DelayBetweenRolls = 1.5,    -- Delay to let spawn animations finish
}

local RollCount = 0

-- ==========================================
-- 2. TIME SKIP (Bypass Time)
-- ==========================================
local function SkipTime()
    if not Settings.AutoSkipTime then return end
    print("[TimeBypass] Skipping time...")
    
    -- Method 1: API Call (Most Reliable if available)
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
    
    if Remotes and Remotes.Gameplay and Remotes.Gameplay.TimeSkip then
        Remotes.Gameplay.TimeSkip:FireServer()
        wait(1)
        print("[TimeBypass] Time Skipped via API.")
        return
    end
    
    -- Method 2: GUI Click (Fallback)
    local gui = Player:FindFirstChild("PlayerGui")
    if gui then
        -- Try common UI names for the Skip Time button
        local screen = gui:FindFirstChild("ScreenGui") or gui:FindFirstChild("StarterGui")
        if screen then
            local skipBtn = screen:FindFirstChild("Frame") and screen.Frame:FindFirstChild("Skip")
            if not skipBtn then
                -- Try alternative UI structures
                skipBtn = screen:FindFirstChild("SkipTimeButton") or screen:FindFirstChild("Skip")
            end
            if skipBtn and skipBtn:IsA("TextButton") or skipBtn:IsA("ImageButton") then
                skipBtn:MouseButton1Click()
                wait(1)
                print("[TimeBypass] Time Skipped via GUI.")
            else
                print("[TimeBypass] GUI button not found.")
            end
        end
    end
end

-- ==========================================
-- 3. LUCK 999x (Seed Farming)
-- ==========================================
local function CheckSeed(fruit)
    if not fruit or not fruit:IsA("Tool") then return false end
    
    local rarity = fruit:GetAttribute("Rarity")
    
    -- 999x Logic: Only keep Legendary or Mythical (or the specific Target)
    -- This simulates finding a "Good Seed"
    if fruit.Name == Settings.TargetFruit then
        print("[Luck999] Found Target: " .. fruit.Name .. "!")
        return true
    elseif rarity == "Legendary" or rarity == "Mythical" then
        -- Optional: Dispose of other good fruits to speed up search
        -- fruit:Destroy()
        return false
    else
        -- Bad seed, dispose immediately
        fruit:Destroy()
        return false
    end
end

-- ==========================================
-- 4. BYPASS CASH (Free Fruit Spawn)
-- ==========================================
local function SpawnFreeFruit()
    print("[CashBypass] Spawning Free Fruit...")
    
    -- Find the Spawn Tool
    local spawnTool = nil
    -- Look for common names
    for _, name in ipairs({"Spawn Fruit", "Free Fruit", "SpawnTool"}) do
        spawnTool = Player.Backpack:FindFirstChild(name)
        if spawnTool then break end
    end
    
    if not spawnTool then
        print("[CashBypass] No spawn tool found. Check your Backpack.")
        return nil
    end
    
    -- Equip and Activate
    local hum = Character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum:EquipTool(spawnTool)
        spawnTool:Activate()
        wait(0.5)
    end
    
    -- Wait for fruit to appear in backpack
    for i = 1, 10 do
        wait(0.1)
        local newFruit = Player.Backpack:FindFirstChildOfClass("Tool")
        if newFruit and newFruit:IsA("Tool") then
            return newFruit
        end
    end
    return nil
end

-- ==========================================
-- 5. MAIN LOOP
-- ==========================================
local function MainLoop()
    print("[UltraScript] Starting Ultra Farming Loop...")
    print("[UltraScript] Target: " .. Settings.TargetFruit)
    print("[UltraScript] Max Rolls: " .. Settings.MaxRolls)

    while RollCount < Settings.MaxRolls do
        RollCount = RollCount + 1
        print("\n[Roll #" .. RollCount .. "] Starting cycle...")

        -- 1. Skip Time
        SkipTime()

        -- 2. Spawn Fruit
        local fruit = SpawnFreeFruit()
        
        if not fruit then
            print("[Roll #" .. RollCount .. "] Failed to spawn fruit. Waiting to retry...")
            wait(Settings.DelayBetweenRolls)
            continue
        end

        -- 3. Check Seed
        local isTarget = CheckSeed(fruit)

        if isTarget then
            print("[Roll #" .. RollCount .. "] SUCCESS! Equipping " .. fruit.Name .. "...")
            -- Equip the found fruit
            local hum = Character:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:EquipTool(fruit)
            end
            print("[UltraScript] Target acquired! Script can now stop or continue farming.")
            -- Optional: Break here if you only want one
            -- break 
        else
            print("[Roll #" .. RollCount .. "] No luck. Disposed fruit.")
        end

        -- Wait before next roll
        wait(Settings.DelayBetweenRolls)
    end

    print("[UltraScript] Max rolls (" .. Settings.MaxRolls .. ") reached. Stopping.")
end

-- Start the loop
MainLoop()
