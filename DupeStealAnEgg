-- PHẦN 3: CHỨC NĂNG DUPE
-- ==========================================

function UpdateStatus(msg)
    StatusLabel.Text = msg
end

function SpamEvent(Event, Type)
    if not Event then
        UpdateStatus("Không tìm thấy Event " .. Type .. "!")
        return
    end
    
    UpdateStatus("Đang dupe " .. Type .. "...")
    
    local successCount = 0
    
    for i = 1, MaxAttempts do
        pcall(function()
            -- Gửi yêu cầu
            if Event:IsA("RemoteEvent") then
                Event:FireServer()
            elseif Event:IsA("RemoteFunction") then
                Event:InvokeServer()
            end
        end)
        
        wait(DelayMs / 1000)
    end
    
    -- Đợi server xử lý
    wait(1)
    
    -- Kiểm tra kết quả (Giả định đơn giản: nếu không lỗi thì coi như thành công)
    -- Bạn có thể thêm logic kiểm tra số lượng trứng/pet cụ thể ở đây nếu biết biến lưu trữ
    UpdateStatus("Hoàn thành " .. Type .. ". Đã gửi " .. MaxAttempts .. " yêu cầu.")
    
    -- Hiệu ứng nhấp nháy nhẹ để báo hiệu
    local originalColor = BtnEgg.BackgroundColor3
    if Type == "Egg" then
        BtnEgg.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        wait(0.1)
        BtnEgg.BackgroundColor3 = originalColor
    else
        BtnPet.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        wait(0.1)
        BtnPet.BackgroundColor3 = originalColor
    end
end

