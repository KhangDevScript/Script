    Pet = nil
}

-- ==========================================
-- PHẦN 1: TÌM KIẾM EVENT (FIND EVENTS)
-- ==========================================

function FindRemoteEvents()
    print("[SCRIPT] Đang quét các RemoteEvent...")
    
    local eggKeywords = {"Egg", "egg", "GetEgg", "TakeEgg", "ClaimEgg"}
    local petKeywords = {"Pet", "pet", "GetPet", "BuyPet", "ClaimPet", "Summon"}
    
    local function searchContainer(container, type)
        for _, child in pairs(container:GetChildren()) do
            if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                local name = child.Name
                local isMatch = false
                local keywords = type == "Egg" and eggKeywords or petKeywords
                
                for _, keyword in pairs(keywords) do
                    if string.find(name, keyword, 1, true) then
                        isMatch = true
                        break
                    end
                end
                
                if isMatch then
                    print("[SCRIPT] Tìm thấy " .. type .. " Event: " .. name)
                    if type == "Egg" then
                        FoundEvents.Egg = child
                    else
                        FoundEvents.Pet = child
                    end
                    return child 
                end
            elseif child:IsA("Folder") or child:IsA("ModuleScript") or child:IsA("BindableEvent") then
                searchContainer(child, type)
            end
        end
    end
    
    if not FoundEvents.Egg then
        FoundEvents.Egg = searchContainer(ReplicatedStorage, "Egg")
    end
    
    if not FoundEvents.Pet then
        FoundEvents.Pet = searchContainer(ReplicatedStorage, "Pet")
    end
    
    if not FoundEvents.Egg and not FoundEvents.Pet then
        print("[SCRIPT] Cảnh báo: Không tìm thấy Event rõ ràng.")
    end
end

FindRemoteEvents()

