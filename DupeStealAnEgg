-- ==========================================
-- PHẦN 3: LOGIC SPAM & ACTION
-- ==========================================

local function performDupes(remoteEvent, btnObj, labelObj)
    if not remoteEvent then
        if labelObj then
            labelObj.Text = "EVENT NOT FOUND!"
            task.wait(2)
            labelObj.Text = "Ready"
        end
        return
    end

    if labelObj then
        labelObj.Text = "Spamming..."
    end
    
    for i = 1, MaxAttempts do
        if labelObj then
            labelObj.Text = string.format("Spam: %d/%d", i, MaxAttempts)
        end
        
        remoteEvent:FireServer()
        task.wait(DelayMs / 1000) 
    end
    
    if labelObj then
        labelObj.Text = "Done!"
        task.wait(1)
        labelObj.Text = "Ready"
    end
end

